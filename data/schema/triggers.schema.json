{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "title": "Triggers",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["hero", "kind", "source"],
    "properties": {
      "hero": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "kind": { "type": "string", "enum": ["renown", "own", "battle-won-at", "attacked", "defeated-hero", "brother", "campaign-announced"] },
      "min": { "type": "integer", "minimum": 1, "maximum": 2000 },
      "prefecture": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "target": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "source": { "type": "string", "minLength": 3 }
    }
  }
}
